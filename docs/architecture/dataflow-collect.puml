@startuml
' drevops/tui - data flow for headless collection.
' Traced from src/Tui.php (collect) and src/Screen/Collector.php
' (answers -> fetched -> settle -> resolveAll -> transformSupplied -> stabilize
' -> refusal).
' Regenerate every SVG with:  plantuml -tsvg docs/architecture/*.puml
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
title Data flow: headless collection (Tui::collect)

participant "Caller" as Caller
participant "Tui" as Tui
participant "InputResolver" as IR
participant "Collector" as Col
participant "Block tree\n(Panel -> Field)" as Tree
participant "Field behaviour\n(closure or static)" as B
participant "Discovery spec" as Disc
participant "Deriver\n+ Derive" as Der
participant "Condition" as CE
participant "Answers" as Ans

Caller -> Tui: collect(prompts, directory, update, version)
activate Tui

Tui -> Tree: root()
Tree --> Tui: the declared Panel

Tui -> IR: resolve(fields, prompts, env)
activate IR
IR --> Tui: supplied values
deactivate IR

Tui -> Col: answers(panel, supplied, context)
activate Col

Col -> Tree: fields(panel)
note right of Col: no Screen, Layout or Region is built,\nand no block that only shows

loop each field whose rows are loaded
  Col -> B: options callback()
  B --> Col: value => label rows
  note right of Col: nothing would open a field, so a loader\nis asked here or its rows never arrive
end

loop each field, in declaration order
  alt update mode and nothing supplied
    Col -> Disc: discover(directory)
    Disc --> Col: detected value
    note right of Col: adopted only when it passes the field's\nemptiness, type, bounds and rows
  end
  note right of Col: supplied > detected > declared default > static default
end

loop each field with a supplied value
  Col -> B: transform(value)
  B --> Col: normalized value
  note right of Col: supplied values normalize first, so derivation,\nconditions and fix-ups see the final value
end

Col -> Der: derive(rules, values, pinned)
activate Der
Der --> Col: derived values (fixpoint)
deactivate Der
Col -> CE: matches(answers)
activate CE
CE --> Col: there / not there, per field
deactivate CE
note right of Col: rows that follow the answers re-resolve,\nfix-ups apply; repeat until nothing moves

loop each field that is there and was supplied
  Col -> B: validate(value)
  B --> Col: reason or null
  note right of Col: emptiness on a required field first,\nthen type, bounds and rows
end

alt a value was refused
  Col --> Tui: CollectException naming the field and the reason
else every value stands
  Col -> Ans: forTree(panel, values, provenance)
  Ans --> Col: the self-describing set
  Col --> Tui: Answers
end
deactivate Col

Tui --> Caller: Answers
deactivate Tui
@enduml
