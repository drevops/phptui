{
    "extends": ["config:recommended"],
    "automerge": true,
    "rangeStrategy": "bump",
    "dependencyDashboard": true,
    "pinDigests": true,
    "branchPrefix": "deps/",
    "packageRules": [
        {
            "matchDepNames": ["php"],
            "matchManagers": ["composer"],
            "enabled": false
        },
        {
            "matchManagers": ["composer"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Docusaurus 3 runs its own Babel 7 preset from 'docs/babel.config.js', so the docs build fails on Babel 8.",
            "matchManagers": ["npm"],
            "matchPackageNames": ["@babel/core", "@babel/preset-env", "@babel/preset-react"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "matchPackageNames": ["*"],
            "groupName": "all dependencies",
            "groupSlug": "all"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Images pinned by digest in workflow 'run' steps.",
            "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
            "matchStrings": ["docker run .* (?<depName>[a-z0-9][a-z0-9._/-]*)@(?<currentDigest>sha256:[a-f0-9]{64}) # (?<currentValue>\\S+)"],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ]
}
