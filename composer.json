{
    "name": "drevops/phptui",
    "description": "Provides terminal UI form-building functionality.",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "homepage": "https://drevops.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://phptui.dev/",
    "support": {
        "issues": "https://github.com/drevops/phptui/issues",
        "source": "https://github.com/drevops/phptui"
    },
    "require": {
        "php": ">=8.3",
        "alexskrypnyk/str2name": "^1.6.0"
    },
    "require-dev": {
        "alexskrypnyk/phpunit-helpers": "^0.16.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/phpcs-standard": "^1.0.0",
        "drupal/coder": "^9.0.1",
        "ergebnis/composer-normalize": "^2.52.0",
        "mikey179/vfsstream": "^1.6.12",
        "opis/closure": "^4.5.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.32",
        "rector/rector": "^2.6.2"
    },
    "suggest": {
        "ext-mbstring": "Provides full Unicode case folding and native multibyte string handling; PCRE-based fallbacks with ASCII-only case folding are used when it is absent."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DrevOps\\PhpTui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DrevOps\\PhpTui\\Tests\\": "tests/phpunit"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "discard-changes": true,
        "policy": {
            "advisories": {
                "block": false,
                "audit": "fail"
            },
            "abandoned": {
                "audit": "report"
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan",
            "rector --dry-run"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "reset": "rm -Rf vendor composer.lock",
        "test": "phpunit --no-coverage",
        "test-coverage": "phpunit"
    }
}
